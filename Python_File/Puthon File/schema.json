{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": ["is_relevant","relevance_reason","relevance_span"],
 "properties": {
  "is_relevant": {"type": ["boolean","null"]},
  "relevance_reason": {"type": "string"},
  "relevance_span": {"type": ["string","null"], "maxLength": 200},
  "problem_statement": {"type": ["string","null"]},
  "client_ask": {"type": ["string","null"]},
  "workflow_object": {"type": ["string","null"]},
  "manual_action": {"type": ["string","null"]},
  "pain_type": {"enum": ["delay","error","volume","cost","visibility","inconsistency","missed_opportunity","other",null]},
  "actor": {"type": ["string","null"]},
  "industry_stated": {"type": ["string","null"]},
  "freq":   {"type": ["object","null"], "properties": {"value":{"type":"string"},"span":{"type":"string"}}},
  "time":   {"type": ["object","null"], "properties": {"value":{"type":"string"},"span":{"type":"string"}}},
  "impact": {"type": ["object","null"], "properties": {"value":{"type":"string"},"span":{"type":"string"}}},
  "current_solution": {"type": ["string","null"]},
  "tools": {"type": "array", "items": {"type":"string"}},
  "hiring_type": {"enum": ["replacing_human_labor","exploring_tech","one_off_project","unclear",null]},
  "spending_observed": {"enum": ["none","hiring_human","paying_for_tool","stated_budget_for_fix",null]},
  "buyer_intent_observed": {"enum": ["none","vague_interest","active_request","explicit_scope_and_budget",null]},
  "automation_fit": {"enum": ["high","medium","low","none",null]},
  "automation_fit_reason": {"type": ["string","null"]},
  "automation_inappropriate": {"type": ["boolean","null"]},
  "solution_modes": {"type":"array","items":{"enum":["process_fix","no_code_automation","custom_code","website_or_form","llm_component","hire_human","none"]}},
  "required_capabilities": {"type":"array","items":{"type":"string"}},
  "missing_info": {"type":"array","items":{"type":"string"}},
  "pattern": {"type":["object","null"], "properties": {
     "existing_id": {"type":["string","null"]}, "proposed_name": {"type":["string","null"]}, "reason": {"type":"string"}}},
  "evidence_items": {"type":"array","maxItems":5,"items":{"type":"object",
     "required":["field","span","kind"],
     "properties":{"field":{"type":"string"},"span":{"type":"string","maxLength":200},
                   "kind":{"enum":["observation","inference"]}}}}
 }
}
